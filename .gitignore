# Maven / Java
backend/**/target/
backend/logs/

# Node / Angular
frontend/node_modules/
frontend/dist/
frontend/.angular

# Bases de datos locales (H2)
data/

# Logs
*.log
*.err

# Sistema operativo
.DS_Store
Thumbs.db

# Resolucion de conflictos
*.orig
*.rej

# Variables de entorno (no deberian estar, pero por si acaso)
.env
.env.local

# IDE

# IntelliJ IDEA
.idea/
*.iml

# Visual Studio Code (config personal; la compartida va en .vscode/ del repo si se decide)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Eclipse
# .project, .classpath y .settings/ son específicos de cada máquina: si se commitean,
# generan conflictos entre Eclipse y cualquier otro editor, y paths absolutos rotos.
.project
.classpath
.settings/
.factorypath
*.launch
